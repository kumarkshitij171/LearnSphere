# Copy to .env (gitignored). Values must match backend/.env.
ACCESS_TOKEN_SECRET=access_token
INTERNAL_API_KEY=internal_api_key
CATALOGUE_BASE_URL=http://localhost:5000
MOCK_PAYMENTS_ENABLED=true
MOCK_WEBHOOK_SECRET=mock_webhook_secret
# Razorpay (Phase 4). Dashboard webhook URL: <public host>/api/v1/webhooks/razorpay
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (Phase 5). Webhook URL: <public host>/api/v1/webhooks/stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
