# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://testUser:mysecretpassword@localhost:5432/lmsdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URI=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=59m
BCRYPT_PEPPER=your_bcrypt_pepper_here

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER_EMAIL=your@gmail.com
SMTP_PASSWORD=your_app_password_here

# ── AWS / MinIO (S3-compatible) ───────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_RAW_VIDEO_BUCKET=raw-video
S3_PROCESSED_VIDEO_BUCKET=processed-video
PRESIGNED_URL_EXPIRY=3600

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=lms-backend

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=30

# ── Notification Service ──────────────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=http://localhost:8085
