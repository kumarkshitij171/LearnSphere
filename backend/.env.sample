DATABASE_URL = 'postgres://testUser:mysecretpassword@localhost:5434/testDB'
PORT = 5000
CLIENT_URL = "http://localhost:3000"
REDIS_URI = 'redis://default:local@localhost:6379'
JWT_SECRET = 'jwt_secret'
BCRYPT_PEPPER="123"
ACCESS_TOKEN_SECRET=access_token
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_SECRET=refresh_token
REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=development
# AWS Configuration
# true -> use LocalStack for local dev; false -> real AWS account
LOCAL_STACK_DATA_SOURCE=true
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Superseded by LOCAL_STACK_DATA_SOURCE; kept for reference
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3 Buckets
S3_RAW_VIDEO_BUCKET=raw-video
# S3_PROCESSED_VIDEO_BUCKET=processed-video   # used by video-transcoder, not backend
PRESIGNED_URL_EXPIRY=3600
# Origins allowed to PUT directly to S3 via presigned URLs (comma-separated). Defaults to CLIENT_URL.
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000
# SQS
# SQS_ENDPOINT=http://localhost:4566          # superseded by LOCAL_STACK_DATA_SOURCE
SQS_QUEUE_URL=http://localhost:4566/000000000000/video-transcode-queue
# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=lms-backend
# KAFKA_TOPIC_VIDEO_TRANSCODE=video-transcode   # backend reads KAFKA_TOPIC_VIDEO_UPLOADED (default: video.uploaded)
# Email is sent by notification-service (backend publishes to the `notifications` topic)
KAFKA_TOPIC_NOTIFICATIONS=notifications
TENANT_ID=learnsphere
# Shared secret for service-to-service calls to /api/v1/internal/* (order-service)
INTERNAL_API_KEY=internal_api_key
# Shared secret for the video-transcoder -> backend callback
TRANCODER_API_KEY=transcoder_dev_key
RATE_LIMIT_MAX=1000
