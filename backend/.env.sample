DATABASE_URL = 'postgres://testUser:mysecretpassword@localhost:5432/testDB'
PORT = 5000
CLIENT_URL = "http://localhost:3000/"
REDIS_URI = 'rediss://default:local@localhost:6379'
JWT_SECRET = 'jwt_secret'
SMTP_PASSWORD='1234567890'
SMTP_USER_EMAIL= xxxxxxx@gmail.com
SMTP_PORT= 465
SMTP_HOST=smtp.gmail.com
SMTP_SERVICE= gmail
BCRYPT_PEPPER="123"
ACCESS_TOKEN_SECRET=access_token
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_SECRET=refresh_token
REFRESH_TOKEN_EXPIRY=59m
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
# S3 Buckets
S3_RAW_VIDEO_BUCKET=raw-video-bucket-name
S3_FORCE_PATH_STYLE=false
S3_PROCESSED_VIDEO_BUCKET=processed-video-bucket-name
# SQS
SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account/queue-name
# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=video-transcode-service
KAFKA_TOPIC_VIDEO_TRANSCODE=video-transcode
# Application
NODE_ENV=development
PORT=8000
PRESIGNED_URL_EXPIRY=3600