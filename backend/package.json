{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "dotenvx run -- node dist/src/main",
    "start:prod": "dotenvx run -f .env.production -- node dist/src/main",
    "dev": "dotenvx run -- ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "dev:staging": "dotenvx run -f .env.staging -- ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "debug": "dotenvx run -- ts-node-dev --respawn --transpile-only --inspect=0.0.0.0:9229 src/main.ts",
    "env:encrypt": "dotenvx encrypt",
    "env:encrypt:prod": "dotenvx encrypt -f .env.production",
    "env:set": "dotenvx set",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenvx run -- prisma migrate dev",
    "prisma:push": "dotenvx run -- prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.39.0",
