NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://testUser:mysecretpassword@localhost:5432/testDB

# Authentication
JWT_SECRET=change-me
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=59m
BCRYPT_PEPPER=pepper

# Email (Mailhog/SMTP dev defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SERVICE=
SMTP_USER_EMAIL=test@example.com
SMTP_PASSWORD=password

# Redis
REDIS_URI=redis://:local@localhost:6379

# AWS / S3 (works for MinIO/LocalStack when endpoint + path-style are set)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
S3_RAW_VIDEO_BUCKET=raw-video-bucket
S3_PROCESSED_VIDEO_BUCKET=processed-video-bucket
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_EXPIRY=3600

# SQS (LocalStack example URL; replace with real AWS queue URL later)
SQS_QUEUE_URL=http://localhost:4566/000000000000/video-transcode
SQS_ENDPOINT=http://localhost:4566

