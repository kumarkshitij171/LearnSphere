// npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String
  isVerified Boolean  @default(false)
  password   String // hashed password get stored here
  courses    String[] // store course id that user purchased
  avatar     String?
  extended   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Video      Video[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  thumbnail   String
  author      String
  // review
  // comments
  // links
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]
}

model Video {
  id              String              @id @default(uuid())
  userId          String
  originalKey     String // S3 key for original video (e.g. raw-videos/videoId/original.mp4)
  title           String
  description     String?
  duration        Int? // duration in seconds
  fileName        String? // original file name
  fileSize        Int? // original file size in bytes
  mimeType        String
  status          VideoStatus        @default(UPLOADED)
  hlsMasterPath   String? // S3 key for HLS master playlist (e.g. processed-videos/videoId/master.m3u8)
  resolutions     Json? // Array of transcoded resolution metadata
  metadata        Json? // Video metadata (codec, etc.)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id])
  transcodeJobs   VideoTranscodeJob[]
  Course          Course?            @relation(fields: [courseId], references: [id])
  courseId        String?
}

model VideoTranscodeJob {
  id         String    @id @default(uuid())
  videoId    String
  resolution String // e.g., "1080p", "720p", "480p"
  status     JobStatus @default(QUEUED)
  inputKey   String
  outputKey  String?
  error      String?
  progress   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  video      Video     @relation(fields: [videoId], references: [id])
}

enum VideoStatus {
  UPLOADED    // Video uploaded to S3, awaiting transcoding
  TRANSCODING // Transcoder is processing
  READY       // HLS available, ready for playback
  FAILED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
