{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learnsphere.dev/schemas/ui-config.v2.json",
  "title": "LearnSphere UI configuration",
  "description": "Presentation only: what the frontend shows. Never business rules, never executable content. The public read endpoint serves this document, so it must never hold a secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "branding",
    "theme",
    "navigation",
    "home",
    "auth",
    "features",
    "copy",
    "announcement"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Bumped only on a breaking change; see config/ui/migrations.ts.",
      "enum": [
        2
      ]
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appName",
        "wordmark",
        "tagline",
        "logoUrl",
        "supportEmail"
      ],
      "properties": {
        "appName": {
          "description": "Used in titles, emails and the footer.",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "wordmark": {
          "description": "The logo text: `primary` in the foreground colour, `accent` in the primary colour.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "accent"
          ],
          "properties": {
            "primary": {
              "type": "string",
              "maxLength": 24
            },
            "accent": {
              "type": "string",
              "maxLength": 24
            }
          }
        },
        "tagline": {
          "type": "string",
          "maxLength": 80
        },
        "logoUrl": {
          "description": "Relative path or https URL. null = the default icon.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "^(/|https://)"
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        }
      }
    },
    "theme": {
      "description": "The two designed looks plus the colours an admin may change without breaking contrast.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "highlight",
        "radius"
      ],
      "properties": {
        "mode": {
          "description": "light = the studio look; dark = the theater look, app-wide. The video player is always dark.",
          "enum": [
            "light",
            "dark"
          ]
        },
        "highlight": {
          "description": "\"You are here\": active page, current lesson, today. Shown behind ink, so keep it light (L ≥ 55%).",
          "$ref": "#/definitions/hsl"
        },
        "radius": {
          "description": "Corner radius of controls, e.g. 0.625rem.",
          "type": "string",
          "pattern": "^(0|[0-9]*\\.?[0-9]+(rem|px))$"
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sidebar",
        "sidebarBottom"
      ],
      "properties": {
        "sidebar": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/navItem"
          }
        },
        "sidebarBottom": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/navItem"
          }
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero",
        "sections",
        "features",
        "howItWorks",
        "faq",
        "finalCta"
      ],
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "titleHighlight",
            "subtitle",
            "ctaLabel",
            "ctaHref",
            "secondaryLabel",
            "secondaryHref",
            "footnote"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "maxLength": 60
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "titleHighlight": {
              "description": "Second line, in the second tone.",
              "type": "string",
              "maxLength": 60
            },
            "subtitle": {
              "type": "string",
              "maxLength": 280
            },
            "ctaLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "ctaHref": {
              "$ref": "#/definitions/href"
            },
            "secondaryLabel": {
              "description": "Text link beside the main button; empty hides it.",
              "type": "string",
              "maxLength": 40
            },
            "secondaryHref": {
              "$ref": "#/definitions/href"
            },
            "footnote": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "sections": {
          "description": "The home page sections below the hero, in display order.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "enabled"
            ],
            "properties": {
              "type": {
                "enum": [
                  "features",
                  "howItWorks",
                  "faq",
                  "finalCta"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "features": {
          "description": "\"What you get\": only features that exist.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "heading",
            "items"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "maxLength": 40
            },
            "heading": {
              "$ref": "#/definitions/twoTone"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "icon",
                  "title",
                  "body"
                ],
                "properties": {
                  "icon": {
                    "$ref": "#/definitions/icon"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 220
                  }
                }
              }
            }
          }
        },
        "howItWorks": {
          "description": "The instructor section: the steps from nothing to a published course.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "heading",
            "steps"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "maxLength": 40
            },
            "heading": {
              "$ref": "#/definitions/twoTone"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 220
                  }
                }
              }
            }
          }
        },
        "faq": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "items"
          ],
          "properties": {
            "heading": {
              "$ref": "#/definitions/twoTone"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "answer"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "finalCta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "body",
            "ctaLabel",
            "ctaHref"
          ],
          "properties": {
            "heading": {
              "$ref": "#/definitions/twoTone"
            },
            "body": {
              "type": "string",
              "maxLength": 200
            },
            "ctaLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "ctaHref": {
              "$ref": "#/definitions/href"
            }
          }
        }
      }
    },
    "auth": {
      "description": "The panel beside the sign-in and sign-up forms.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "points"
      ],
      "properties": {
        "heading": {
          "$ref": "#/definitions/twoTone"
        },
        "points": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/line"
          }
        }
      }
    },
    "features": {
      "description": "Display-only toggles. Hiding the Buy button does not stop purchases: order-service still decides.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purchases",
        "instructorRequests",
        "studyProgress"
      ],
      "properties": {
        "purchases": {
          "type": "boolean"
        },
        "instructorRequests": {
          "type": "boolean"
        },
        "studyProgress": {
          "type": "boolean"
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseLocked",
        "purchasesPaused",
        "emptyCatalogue"
      ],
      "properties": {
        "courseLocked": {
          "type": "string",
          "maxLength": 280
        },
        "purchasesPaused": {
          "type": "string",
          "maxLength": 280
        },
        "emptyCatalogue": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "message",
        "tone",
        "href"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 200
        },
        "tone": {
          "enum": [
            "info",
            "success",
            "warning"
          ]
        },
        "href": {
          "description": "Optional link; null for none.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "^(/|https://)"
        }
      }
    }
  },
  "definitions": {
    "hsl": {
      "type": "string",
      "pattern": "^\\d{1,3} \\d{1,3}% \\d{1,3}%$"
    },
    "href": {
      "description": "A relative path or an https URL. Anything else (javascript:, data:) is rejected.",
      "type": "string",
      "maxLength": 500,
      "pattern": "^(/|https://)"
    },
    "navItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "icon",
        "href",
        "roles",
        "enabled"
      ],
      "properties": {
        "id": {
          "description": "Stable key; unique across sidebar and sidebarBottom.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "$ref": "#/definitions/icon"
        },
        "href": {
          "description": "null renders the item as not yet available.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "pattern": "^(/|https://)"
        },
        "roles": {
          "description": "Who sees it; [] = everyone. Cosmetic only: routes and APIs enforce access.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": [
              "STUDENT",
              "INSTRUCTOR",
              "ADMIN"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "icon": {
      "description": "A Lucide icon from the allow-list; config never names a component.",
      "enum": [
        "LayoutDashboard",
        "BookOpen",
        "Bookmark",
        "ClipboardList",
        "Compass",
        "Award",
        "Receipt",
        "HelpCircle",
        "Settings",
        "ShieldCheck",
        "SlidersHorizontal",
        "GraduationCap",
        "Users",
        "PlayCircle",
        "Bell",
        "Sparkles",
        "MonitorPlay",
        "History",
        "Keyboard",
        "Wallet",
        "Mail",
        "ListChecks",
        "Upload",
        "Gauge"
      ]
    },
    "line": {
      "type": "string",
      "maxLength": 80
    },
    "twoTone": {
      "description": "A two-tone heading: `title` in ink, `titleHighlight` in the second tone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "titleHighlight"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "titleHighlight": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
