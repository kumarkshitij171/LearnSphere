PORT=7000
NODE_ENV=development
LOG_LEVEL=info

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=video-transcode-service
KAFKA_TOPIC_VIDEO_TRANSCODE=video.uploaded

# true -> LocalStack, false -> real AWS
LOCAL_STACK_DATA_SOURCE=true
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
S3_RAW_VIDEO_BUCKET=raw-video
S3_PROCESSED_VIDEO_BUCKET=processed-video

BACKEND_API_URL=http://localhost:5000
TRANCODER_API_KEY=transcoder_dev_key
CORS_ALLOW_ORIGIN=http://localhost:3000

# optional: a system FFmpeg / FFprobe instead of the bundled ones
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# optional: the tallest rendition produced (default 2160; a taller source tops out here)
# TRANSCODE_MAX_RUNG=2160
# optional: the x264 preset (default veryfast; medium is ~10-15% smaller and slower)
# TRANSCODE_PRESET=veryfast
