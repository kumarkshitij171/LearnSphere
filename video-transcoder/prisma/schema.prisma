// npx prisma db push
// npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  role               Role                @default(STUDENT)
  isVerified         Boolean             @default(false)
  password           String // hashed password get stored here
  courses            String[] // legacy; Enrollment is the source of truth
  avatar             String?
  extended           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Video              Video[]
  coursesAuthored    Course[]            @relation("CourseInstructor")
  enrollments        Enrollment[]
  instructorRequests InstructorRequest[]
}

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String
  price        Float        @default(0)
  thumbnail    String?
  isPublished  Boolean      @default(false)
  instructorId String
  instructor   User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  videos       Video[]
  enrollments  Enrollment[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model InstructorRequest {
  id         String                  @id @default(cuid())
  userId     String
  status     InstructorRequestStatus @default(PENDING)
  message    String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User                    @relation(fields: [userId], references: [id])

  @@index([status])
}

model Video {
  id            String              @id @default(uuid())
  userId        String
  originalKey   String // S3 key for original video
  title         String
  description   String?
  duration      Int?
  fileName      String?
  fileSize      Int?
  mimeType      String
  status        VideoStatus         @default(UPLOADED)
  hlsMasterPath String?
  resolutions   Json?
  metadata      Json? // Video metadata (duration, codec, etc.)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id])
  transcodeJobs VideoTranscodeJob[]
  Course        Course?             @relation(fields: [courseId], references: [id])
  courseId      String?
}

model VideoTranscodeJob {
  id         String    @id @default(uuid())
  videoId    String
  resolution String // e.g., "1080p", "720p", "480p"
  status     JobStatus @default(QUEUED)
  inputKey   String
  outputKey  String?
  error      String?
  progress   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  video      Video     @relation(fields: [videoId], references: [id])
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum InstructorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoStatus {
  UPLOADED
  TRANSCODING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
