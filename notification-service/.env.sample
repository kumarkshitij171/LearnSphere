# Copy to .env (gitignored). Secrets must match backend/.env.
ACCESS_TOKEN_SECRET=access_token
INTERNAL_API_KEY=internal_api_key

# Email. Leave these commented out until you have real values: an empty assignment
# overrides the built-in defaults (and blanks the sender address).
# For Gmail use an app password, not the account password.
# SMTP_USER_EMAIL=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
