# Copy to .env (gitignored). Secrets must match backend/.env.
ACCESS_TOKEN_SECRET=access_token
INTERNAL_API_KEY=internal_api_key

# Email. Leave these commented out until you have real values: an empty assignment
# overrides the built-in defaults (and blanks the sender address).
# For Gmail use an app password, not the account password.
# SMTP_USER_EMAIL=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password

# Browser push (FCM). Off until you have a Firebase service-account key:
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# The frontend needs the matching web config in frontend/.env.local (NEXT_PUBLIC_FIREBASE_*).
# PUSH_ENABLED=true
# FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Rate limits. A user gets at most RATE_LIMIT_PER_USER_TEMPLATE messages of one template per
# RATE_LIMIT_USER_WINDOW; extra ones wait as RETRYING and go out later. Loosen locally for testing only.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_USER_TEMPLATE=5
# RATE_LIMIT_USER_WINDOW=PT10M
