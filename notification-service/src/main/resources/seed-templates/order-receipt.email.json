{
  "name": "order-receipt",
  "channel": "EMAIL",
  "subject": "Your receipt for {{courseTitle}}",
  "templateVariables": {
    "name": "there",
    "courseTitle": null,
    "amount": null,
    "orderId": null,
    "paymentId": "—",
    "purchasedAt": null
  },
  "templateMessage": "<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#111\"><h2 style=\"margin-bottom:4px\">Thanks for your purchase, {{name}}!</h2><p style=\"color:#555;margin-top:0\">You now have full access to <b>{{courseTitle}}</b>.</p><table style=\"width:100%;border-collapse:collapse;margin:24px 0\"><tr><td style=\"padding:8px 0;color:#555\">Course</td><td style=\"padding:8px 0;text-align:right\">{{courseTitle}}</td></tr><tr><td style=\"padding:8px 0;color:#555\">Amount</td><td style=\"padding:8px 0;text-align:right\"><b>{{amount}}</b></td></tr><tr><td style=\"padding:8px 0;color:#555\">Date</td><td style=\"padding:8px 0;text-align:right\">{{purchasedAt}}</td></tr><tr><td style=\"padding:8px 0;color:#555\">Order</td><td style=\"padding:8px 0;text-align:right;font-family:monospace\">{{orderId}}</td></tr><tr><td style=\"padding:8px 0;color:#555\">Payment</td><td style=\"padding:8px 0;text-align:right;font-family:monospace\">{{paymentId}}</td></tr></table><p style=\"color:#888;font-size:12px\">Keep this email as your receipt. — LearnSphere</p></div>"
}
