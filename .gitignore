# Environment files
# .env is ignored because it may contain plain secrets in dev
# Commit the encrypted version instead: dotenvx encrypt
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# dotenvx private keys — NEVER commit these
# Public keys in .env.keys are safe to commit (encrypted files need them)
# But private keys decrypt them, so exclude the whole file for safety
.env.keys

# Allow .env.sample (template without real values)
!.env.sample

